# Required for enforcing 4 video downloads per public IP every rolling 24 hours.
# Generate a unique secret locally: openssl rand -hex 32
# Keep every value below server-side in Vercel Environment Variables (NEVER NEXT_PUBLIC).
DOWNLOAD_SECRET=

# Use a DEDICATED Supabase project for Nexora Downloader ONLY (never All Tools Nexora).
# Apply supabase/migrations/20261020100000_nexora_downloader_ip_video_quota.sql
# to that separate project before deploying. The repository does not provision it automatically.
# This URL is not a secret. Do not use a public key for quota writes.
SUPABASE_URL=https://YOUR_DOWNLOADER_PROJECT_REF.supabase.co

# Supabase Settings > API Keys > Secret API key (sb_secret_...). Do NOT commit.
SUPABASE_SECRET_KEY=

# When any required variable is absent, video options fail closed.
# Photos and audio may still use direct provider links.
